APP_ENV=development
APP_PORT=8080
DATABASE_PING_TIMEOUT=5s

TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Approval Engine integration. Optional at boot — the service still starts
# without these, but every approval action (create request, decision,
# inbound webhook signature check) fails at call time until they're set.
# See docs/asset-system-integration-checklist.md Langkah 1 for how to get
# these values (register the app in Approval-Engine-Client, api_key is
# shown only once).
APPROVAL_ENGINE_BASE_URL=
APPROVAL_ENGINE_API_KEY=

# Origins allowed to call this API from a browser (comma-separated), e.g.
# the asset-system-frontend URL. Leave empty in local dev if unused.
ALLOWED_ORIGINS=
